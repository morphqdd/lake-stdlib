// Process environment — argv, envp, getenv.
//
// Implementation notes
// ────────────────────
// The kernel hands argv/argp on the stack at `_start`.  Cranelift
// cannot describe a stack-arg entry point, so the asm shim in
// `external/entry.asm` snapshots `argc / argv / envp` into BSS
// globals; this module wraps the resulting raw pointers in
// `{atom buf}` tuples for Lake-side consumption.
//
// All argv / envp entries are kernel-supplied null-terminated C
// strings.  `rt_cstr_to_buf` copies them out into Lake-owned `buf`
// values so user code is free to keep them past startup without
// caring about the original mapping's lifetime (it stays live until
// process exit anyway, but copying decouples the abstraction).

@rt(rt_argc_raw)
@rt(rt_argv_raw)
@rt(rt_envp_raw)
@rt(rt_load_ptr_raw)
@rt(rt_cstr_to_buf)
@rt(rt_cstr_len)

// Number of command-line arguments, including argv[0].
pub argc is {
  _ -> ret i64 { ret rt_argc_raw() }
}

// Look up `argv[i]` and copy it into a fresh `buf`.
//   {:ok buf}   — present (caller owns the buf)
//   {:err :nil} — `i` ≥ argc, i.e. out of range
pub argv_at is {
  i i64 -> ret {atom buf} {
    let n = rt_argc_raw()
    when i >= n {
      true  -> { ret rt_cstr_to_buf(0) }
      false -> {
        let base = rt_argv_raw()
        let p = rt_load_ptr_raw(base i)
        ret rt_cstr_to_buf(p)
      }
    }
  }
}

// envp iteration is null-terminated: walk until the entry pointer
// is zero.  `envp_at(i)` returns `{:err :nil}` past the terminator,
// just like `argv_at`.
pub envp_at is {
  i i64 -> ret {atom buf} {
    let base = rt_envp_raw()
    let p = rt_load_ptr_raw(base i)
    ret rt_cstr_to_buf(p)
  }
}

// Buf length lives in `std.bytes.size` — `std.env` returns argv /
// envp entries as Lake-owned bufs, and callers reach for
// `std.bytes.size(b)` to read their length.  Re-exporting it from
// here would duplicate the name (`std.env.size` vs
// `std.bytes.size`) and trip the name-collision bug #97.
