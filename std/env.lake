// Process environment — argv, envp.
// The entry asm shim snapshots argc/argv/envp into BSS globals (the
// kernel hands them on the stack, which Cranelift can't describe).
// `rt_cstr_to_buf` copies each null-terminated entry into a Lake-owned
// `buf`, returned as an `{atom buf}` tuple.

@rt(rt_argc_raw)
@rt(rt_argv_raw)
@rt(rt_envp_raw)
@rt(rt_load_ptr_raw)
@rt(rt_cstr_to_buf)
@rt(rt_cstr_len)

// Number of command-line arguments, including argv[0].
pub argc is {
  _ -> ret i64 { ret rt_argc_raw() }
}

// Look up `argv[i]` and copy it into a fresh `buf`.
//   {:ok buf}   — present (caller owns the buf)
//   {:err :nil} — `i` ≥ argc, i.e. out of range
pub argv_at is {
  i i64 -> ret {atom buf} {
    let n = rt_argc_raw()
    when i >= n {
      true  -> { ret rt_cstr_to_buf(0) }
      false -> {
        let base = rt_argv_raw()
        let p = rt_load_ptr_raw(base i)
        ret rt_cstr_to_buf(p)
      }
    }
  }
}

// envp iteration is null-terminated: walk until the entry pointer
// is zero.  `envp_at(i)` returns `{:err :nil}` past the terminator,
// just like `argv_at`.
pub envp_at is {
  i i64 -> ret {atom buf} {
    let base = rt_envp_raw()
    let p = rt_load_ptr_raw(base i)
    ret rt_cstr_to_buf(p)
  }
}

// For entry length, callers use `std.bytes.size(b)` (re-exporting it
// here would collide — bug #97).
