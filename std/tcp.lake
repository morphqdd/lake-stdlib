// TCP server primitives — thin wrappers over the rt async-I/O surface.
// Each is a ret-typed actor (one mailbox roundtrip per call); for a hot
// send loop call `rt_send_async` / `rt_close` directly.

@rt(rt_listen_tcp)
@rt(rt_accept_async)
@rt(rt_send_async)
@rt(rt_recv_async)
@rt(rt_close)
@rt(len)

/// Open a listening TCP socket bound to `port` on 0.0.0.0.  Returns the
/// raw socket fd as an i64; pass it to `accept` to take connections.
pub listen is {
  port i64 -> ret i64 {
    ret rt_listen_tcp(port)
  }
}

/// Accept the next pending connection on `srv` and return its fd.
/// Blocks the caller until the io_uring accept completes.
pub accept is {
  srv i64 -> ret i64 {
    ret rt_accept_async(srv)
  }
}

/// Send `s` over `conn` (length from its fat pointer).  Sync-return so
/// a follow-up `close` sees the bytes queued before the fd is freed.
pub send is {
  conn i64 s str -> ret i64 {
    rt_send_async(conn s len(s))
    ret 0
  }
}

/// Read up to `size` bytes from `conn` into `buf`.  Returns the byte
/// count read; 0 means the peer closed the connection.
pub recv is {
  conn i64 buf buf size i64 -> ret i64 {
    ret rt_recv_async(conn buf size)
  }
}

/// Close `conn`.  Synchronous-return so callers can sequence
/// teardown deterministically.
pub close is {
  conn i64 -> ret i64 {
    rt_close(conn)
    ret 0
  }
}
