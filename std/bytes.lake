// Bounded byte-level access over the `rt_load_u*` / `rt_store`
// primitives.  Each wrapper is one rt-call; this module adds naming
// and the composed `be32`/`set_be32` helpers.  Out-of-range offsets
// trap via the rt-fn bounds check.

@rt(rt_load_u8)
@rt(rt_load_u16)
@rt(rt_load_u32)
@rt(rt_load_u64)
@rt(rt_store)
@rt(buf_len)
@rt(buf_ptr)
@rt(buf_trim)

// ── buf metadata ───────────────────────────────────────────────

// Byte length of `b`.  Mirrors `len()` on `str`, typed for `buf`
// (see #45 for why these are distinct source types).
pub size is {
  b buf -> ret i64 { ret buf_len(b) }
}

// Raw byte address of the buf's payload — for syscalls wanting a
// `char*` (see `std.experimental.fs.open`).
pub addr is {
  b buf -> ret i64 { ret buf_ptr(b) }
}

// Trim a buf's reported length to `new_len` — `rt_allocate` returns
// a fat-pointer sized to the allocator bucket, not the request, so
// `pin trim(b n)` after filling `n` bytes fixes `size`/`len`.
// Unbounded: `new_len > bucket_size` reads into allocator metadata.
pub trim is {
  b buf new_len i64 -> ret i64 {
    buf_trim(b new_len)
    ret 0
  }
}

// ── byte loads ─────────────────────────────────────────────────

// Read one byte from `buf` at `off`.  Same as `buf[off]`; kept as a
// named wrapper for callers wanting a function reference.
pub at is {
  buf buf off i64 -> ret i64 {
    ret buf[off]
  }
}

// 16-bit little-endian read.
pub at16 is {
  buf buf off i64 -> ret i64 {
    ret rt_load_u16(buf off)
  }
}

// 32-bit little-endian read.
pub at32 is {
  buf buf off i64 -> ret i64 {
    ret rt_load_u32(buf off)
  }
}

// 64-bit little-endian read.
pub at64 is {
  buf buf off i64 -> ret i64 {
    ret rt_load_u64(buf off)
  }
}

// ── byte stores ────────────────────────────────────────────────

// Write a single byte (`val & 0xff`) into `buf` at `off`.
pub set is {
  buf buf off i64 val i64 -> ret i64 {
    rt_store(buf val 1 off)
    ret 0
  }
}

// Write a 16-bit value, little-endian.
pub set16 is {
  buf buf off i64 val i64 -> ret i64 {
    rt_store(buf val 2 off)
    ret 0
  }
}

// Write a 32-bit value, little-endian.
pub set32 is {
  buf buf off i64 val i64 -> ret i64 {
    rt_store(buf val 4 off)
    ret 0
  }
}

// Write a 64-bit value, little-endian.
pub set64 is {
  buf buf off i64 val i64 -> ret i64 {
    rt_store(buf val 8 off)
    ret 0
  }
}

// ── big-endian helpers ─────────────────────────────────────────

// Read a 32-bit big-endian word (crypto / network byte order).
pub be32 is {
  buf buf off i64 -> ret i64 {
    let b0 = buf[off]
    let b1 = buf[off + 1]
    let b2 = buf[off + 2]
    let b3 = buf[off + 3]
    ret b0 << 24 | b1 << 16 | b2 << 8 | b3
  }
}

// Write a 32-bit big-endian word.
pub set_be32 is {
  buf buf off i64 val i64 -> ret i64 {
    rt_store(buf val >> 24 & 0xff 1 off)
    rt_store(buf val >> 16 & 0xff 1 off + 1)
    rt_store(buf val >> 8  & 0xff 1 off + 2)
    rt_store(buf val       & 0xff 1 off + 3)
    ret 0
  }
}
