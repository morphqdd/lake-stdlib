// Direct-syscall stdout/stderr I/O — one `write(2)` per call, no
// `rt_write` or io_uring hand-off.  Same shape as `std.io`; ret-typed
// so `pin` can sequence output.

+std.experimental.sys.{ SYS_WRITE FD_STDOUT FD_STDERR }

@rt(rt_syscall)
@rt(rt_str_ptr)
@rt(len)

pub print is {
  s str -> ret i64 {
    rt_syscall(SYS_WRITE FD_STDOUT rt_str_ptr(s) len(s) 0 0 0)
    ret 0
  }
}

pub println is {
  s str -> ret i64 {
    rt_syscall(SYS_WRITE FD_STDOUT rt_str_ptr(s) len(s) 0 0 0)
    rt_syscall(SYS_WRITE FD_STDOUT rt_str_ptr("\n") 1 0 0 0)
    ret 0
  }
}

pub eprint is {
  s str -> ret i64 {
    rt_syscall(SYS_WRITE FD_STDERR rt_str_ptr(s) len(s) 0 0 0)
    ret 0
  }
}

pub eprintln is {
  s str -> ret i64 {
    rt_syscall(SYS_WRITE FD_STDERR rt_str_ptr(s) len(s) 0 0 0)
    rt_syscall(SYS_WRITE FD_STDERR rt_str_ptr("\n") 1 0 0 0)
    ret 0
  }
}
