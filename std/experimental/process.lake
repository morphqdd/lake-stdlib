// Direct-syscall process management — clone3+pidfd / execve / waitid.
// For invoking external programs (lakec, git, …) from an actor — NOT
// for spawning Lake actors (use `spawn`).  The child execve's
// immediately; an execve failure exits via raw SYS_EXIT.
// See docs/state (#099) — parent parks on pidfd POLLADD, no spin.

+std.experimental.sys.{ SYS_EXECVE SYS_EXIT }
+std.experimental.fs.{ cstr_of }
+std.process.{ alloc_or_die }
+std.bytes.{ addr }

@rt(rt_syscall)
@rt(rt_store)
@rt(rt_load_u64)
@rt(rt_envp_raw)
@rt(rt_clone3_pidfd)
@rt(rt_pidfd_poll_async)
@rt(rt_waitid_pidfd)
@rt(rt_close)

// Build a 3-slot NULL-terminated `char**` array (two cstr pointers
// + terminating zero) for execve.
build_argv_2 is {
  p0 i64 p1 i64 -> ret buf {
    let av = alloc_or_die(24)
    rt_store(av p0 8 0)
    rt_store(av p1 8 8)
    rt_store(av 0  8 16)
    ret av
  }
}

// 4-slot variant for 3-argv programs (`prog a1 a2`).
build_argv_3 is {
  p0 i64 p1 i64 p2 i64 -> ret buf {
    let av = alloc_or_die(32)
    rt_store(av p0 8 0)
    rt_store(av p1 8 8)
    rt_store(av p2 8 16)
    rt_store(av 0  8 24)
    ret av
  }
}

// Cooperative wait: park on pidfd POLLADD, then one non-blocking
// waitid harvests the exit status.  No spinning — peers keep running.
wait_pidfd is {
  pidfd i64 -> ret {atom i64} {
    rt_pidfd_poll_async(pidfd)
    let status = rt_waitid_pidfd(pidfd)
    rt_close(pidfd)
    when status < 0 {
      true  -> { ret { :err 0 - status } }
      false -> { ret { :ok status } }
    }
  }
}

// Run `prog` with argv = [prog, a1].  `{:ok exit_code}` on clean wait,
// `{:err errno}` if clone3/waitid failed; execve failure → exit 127.
pub run is {
  prog buf a1 buf -> ret {atom i64} {
    let pc = cstr_of(prog)
    let c1 = cstr_of(a1)
    let av = build_argv_2(addr(pc) addr(c1))
    let ev = rt_envp_raw()
    let pidfd = rt_clone3_pidfd(0)
    when pidfd < 0 {
      true  -> { ret { :err 0 - pidfd } }
      false -> {
        when pidfd == 0 {
          true  -> {
            // `ev` is already a raw `char**` from the asm shim.
            rt_syscall(SYS_EXECVE addr(pc) addr(av) ev 0 0 0)
            rt_syscall(SYS_EXIT 127 0 0 0 0 0)
            ret { :err 127 }
          }
          false -> {
            let result = wait_pidfd(pidfd)
            ret result
          }
        }
      }
    }
  }
}

// 3-argv variant — `argv = [prog, a1, a2]`.  Inherits parent envp.
pub run3 is {
  prog buf a1 buf a2 buf -> ret {atom i64} {
    let pc = cstr_of(prog)
    let c1 = cstr_of(a1)
    let c2 = cstr_of(a2)
    let av = build_argv_3(addr(pc) addr(c1) addr(c2))
    let ev = rt_envp_raw()
    let pidfd = rt_clone3_pidfd(0)
    when pidfd < 0 {
      true  -> { ret { :err 0 - pidfd } }
      false -> {
        when pidfd == 0 {
          true  -> {
            rt_syscall(SYS_EXECVE addr(pc) addr(av) ev 0 0 0)
            rt_syscall(SYS_EXIT 127 0 0 0 0 0)
            ret { :err 127 }
          }
          false -> {
            let result = wait_pidfd(pidfd)
            ret result
          }
        }
      }
    }
  }
}

// `run` with caller-supplied envp — a raw `char**` (NULL-terminated
// cstring-pointer array built via `rt_store` over a buf).
pub run_envp is {
  prog buf a1 buf envp_ptr i64 -> ret {atom i64} {
    let pc = cstr_of(prog)
    let c1 = cstr_of(a1)
    let av = build_argv_2(addr(pc) addr(c1))
    let pidfd = rt_clone3_pidfd(0)
    when pidfd < 0 {
      true  -> { ret { :err 0 - pidfd } }
      false -> {
        when pidfd == 0 {
          true  -> {
            rt_syscall(SYS_EXECVE addr(pc) addr(av) envp_ptr 0 0 0)
            rt_syscall(SYS_EXIT 127 0 0 0 0 0)
            ret { :err 127 }
          }
          false -> {
            let result = wait_pidfd(pidfd)
            ret result
          }
        }
      }
    }
  }
}

// `run` with both a caller-supplied argv AND envp — each a raw
// NULL-terminated `char**` (a buf filled via `rt_store`).  `argv_ptr`
// must already include argv[0] (the program path).  Lets callers pass
// an arbitrary number of CLI args (e.g. house manifest `flag` lines).
pub run_envp_argv is {
  prog buf argv_ptr i64 envp_ptr i64 -> ret {atom i64} {
    let pc = cstr_of(prog)
    let pidfd = rt_clone3_pidfd(0)
    when pidfd < 0 {
      true  -> { ret { :err 0 - pidfd } }
      false -> {
        when pidfd == 0 {
          true  -> {
            rt_syscall(SYS_EXECVE addr(pc) argv_ptr envp_ptr 0 0 0)
            rt_syscall(SYS_EXIT 127 0 0 0 0 0)
            ret { :err 127 }
          }
          false -> {
            let result = wait_pidfd(pidfd)
            ret result
          }
        }
      }
    }
  }
}
