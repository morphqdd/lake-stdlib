// Direct-syscall process management — clone3+pidfd / execve / waitid.
//
// This module sits at the lowest possible level: it manipulates raw
// kernel handles without any of the Lake scheduler's bookkeeping.
// Use it to invoke external programs (`lakec`, `git`, …) from a
// Lake actor; do NOT use it to spawn child Lake actors — that's
// what the regular `spawn` keyword is for.
//
// After clone3 the child process inherits a *copy* of the parent's
// scheduler / io_uring state, but ignoring it is safe because we
// immediately call `execve` to replace the address space.  If the
// `execve` itself fails the child exits via raw `SYS_EXIT` so it
// never returns into Lake actor code.
//
// Phase 1 of #099: parent parks on io_uring POLLADD over the pidfd
// instead of spinning wait4(WNOHANG), so peer actors keep running
// for the full child lifetime.

+std.experimental.sys.{ SYS_EXECVE SYS_EXIT }
+std.experimental.fs.{ cstr_of }
+std.process.{ alloc_or_die }
+std.bytes.{ addr }

@rt(rt_syscall)
@rt(rt_store)
@rt(rt_load_u64)
@rt(rt_envp_raw)
@rt(rt_clone3_pidfd)
@rt(rt_pidfd_poll_async)
@rt(rt_waitid_pidfd)
@rt(rt_close)

// Build a 3-slot NULL-terminated `char**` array (two cstr pointers
// + terminating zero) for execve.
build_argv_2 is {
  p0 i64 p1 i64 -> ret buf {
    let av = alloc_or_die(24)
    rt_store(av p0 8 0)
    rt_store(av p1 8 8)
    rt_store(av 0  8 16)
    ret av
  }
}

// 4-slot variant for 3-argv programs (`prog a1 a2`).
build_argv_3 is {
  p0 i64 p1 i64 p2 i64 -> ret buf {
    let av = alloc_or_die(32)
    rt_store(av p0 8 0)
    rt_store(av p1 8 8)
    rt_store(av p2 8 16)
    rt_store(av 0  8 24)
    ret av
  }
}

// Cooperative wait: pidfd POLLADD parks the actor on the io_uring
// CQ; when the child exits the kernel makes the pidfd readable, our
// wake-by-user_data path resumes us, and a single non-blocking
// waitid harvests the exit status.  No spinning, no global freeze —
// peer actors keep running for the full child lifetime.
wait_pidfd is {
  pidfd i64 -> ret {atom i64} {
    rt_pidfd_poll_async(pidfd)
    let status = rt_waitid_pidfd(pidfd)
    rt_close(pidfd)
    when status < 0 {
      true  -> { ret { :err 0 - status } }
      false -> { ret { :ok status } }
    }
  }
}

// Run `prog` with a single argv entry `a1` (so the child sees
// argv = [prog, a1]).  Returns `{:ok exit_code}` on a clean wait,
// `{:err errno}` if clone3 or waitid themselves failed.  An execve
// failure in the child surfaces as `{:ok 127}` (the conventional
// "command not found" exit status).
//
// Concurrency note: the parent parks on io_uring POLLADD over the
// pidfd until the child exits — peer actors keep getting scheduled
// for the full child lifetime.  This replaces the wait4(WNOHANG)
// spin-loop from before #099 Phase 1.
pub run is {
  prog buf a1 buf -> ret {atom i64} {
    let pc = cstr_of(prog)
    let c1 = cstr_of(a1)
    let av = build_argv_2(addr(pc) addr(c1))
    let ev = rt_envp_raw()
    let pidfd = rt_clone3_pidfd(0)
    when pidfd < 0 {
      true  -> { ret { :err 0 - pidfd } }
      false -> {
        when pidfd == 0 {
          true  -> {
            // `ev` is already a raw `char**` pointer from the asm
            // shim — no `addr()` wrap needed.
            rt_syscall(SYS_EXECVE addr(pc) addr(av) ev 0 0 0)
            rt_syscall(SYS_EXIT 127 0 0 0 0 0)
            ret { :err 127 }
          }
          false -> {
            let result = wait_pidfd(pidfd)
            ret result
          }
        }
      }
    }
  }
}

// 3-argv variant of `run` — `argv = [prog, a1, a2]`.  Used for
// shell invocations (`/bin/sh -c CMD`) and any program that needs
// more than one positional arg.  Inherits envp from the parent.
pub run3 is {
  prog buf a1 buf a2 buf -> ret {atom i64} {
    let pc = cstr_of(prog)
    let c1 = cstr_of(a1)
    let c2 = cstr_of(a2)
    let av = build_argv_3(addr(pc) addr(c1) addr(c2))
    let ev = rt_envp_raw()
    let pidfd = rt_clone3_pidfd(0)
    when pidfd < 0 {
      true  -> { ret { :err 0 - pidfd } }
      false -> {
        when pidfd == 0 {
          true  -> {
            rt_syscall(SYS_EXECVE addr(pc) addr(av) ev 0 0 0)
            rt_syscall(SYS_EXIT 127 0 0 0 0 0)
            ret { :err 127 }
          }
          false -> {
            let result = wait_pidfd(pidfd)
            ret result
          }
        }
      }
    }
  }
}

// Same as `run` but with caller-supplied envp.  `envp_ptr` is a
// raw `char**` (i64 pointer to a NULL-terminated array of cstring
// pointers).  Callers build it with `rt_store` over a fresh buf;
// see lake-house's `cmd/build.lake` for the canonical assembly.
pub run_envp is {
  prog buf a1 buf envp_ptr i64 -> ret {atom i64} {
    let pc = cstr_of(prog)
    let c1 = cstr_of(a1)
    let av = build_argv_2(addr(pc) addr(c1))
    let pidfd = rt_clone3_pidfd(0)
    when pidfd < 0 {
      true  -> { ret { :err 0 - pidfd } }
      false -> {
        when pidfd == 0 {
          true  -> {
            rt_syscall(SYS_EXECVE addr(pc) addr(av) envp_ptr 0 0 0)
            rt_syscall(SYS_EXIT 127 0 0 0 0 0)
            ret { :err 127 }
          }
          false -> {
            let result = wait_pidfd(pidfd)
            ret result
          }
        }
      }
    }
  }
}
