@rt(rt_write)
@rt(len)

pub print is {
  s str -> { rt_write(1 s len(s)) }
}

pub println is {
  s str -> {
    rt_write(1 s len(s))
    rt_write(1 "\n" 1)
  }
}

pub eprint is {
  s str -> { rt_write(2 s len(s)) }
}

pub eprintln is {
  s str -> {
    rt_write(2 s len(s))
    rt_write(2 "\n" 1)
  }
}
