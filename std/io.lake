// I/O machines are ret-typed.  A bare call is async (fire-and-forget,
// scheduler-ordered output); prefix with `pin` to force sequential
// execution — `pin println(...)`.

+std.bytes.{ size }

@rt(rt_write)
@rt(len)

pub print is {
  s str -> ret i64 {
    rt_write(1 s len(s))
    ret 0
  }
}

pub println is {
  s str -> ret i64 {
    rt_write(1 s len(s))
    rt_write(1 "\n" 1)
    ret 0
  }
}

pub eprint is {
  s str -> ret i64 {
    rt_write(2 s len(s))
    ret 0
  }
}

pub eprintln is {
  s str -> ret i64 {
    rt_write(2 s len(s))
    rt_write(2 "\n" 1)
    ret 0
  }
}

// ── buf-valued variants ────────────────────────────────────────
// `print`/`println` take `str`; these cover runtime `buf` values
// (argv entries, file reads).

pub print_buf is {
  b buf -> ret i64 {
    rt_write(1 b size(b))
    ret 0
  }
}

pub println_buf is {
  b buf -> ret i64 {
    rt_write(1 b size(b))
    rt_write(1 "\n" 1)
    ret 0
  }
}

pub eprint_buf is {
  b buf -> ret i64 {
    rt_write(2 b size(b))
    ret 0
  }
}

pub eprintln_buf is {
  b buf -> ret i64 {
    rt_write(2 b size(b))
    rt_write(2 "\n" 1)
    ret 0
  }
}
