// Postgres binary-format encoders/decoders for the common OIDs.
//
// Format code 1 = binary, 0 = text.  Binary saves bytes + parser
// passes for fixed-width ints/floats; text is simpler for strings
// and we use it for varchar/text/bytea returned to user code.
//
// OID table (from src/include/catalog/pg_type.dat — pinned subset):
//   bool      = 16   (1 byte: 0/1)
//   bytea     = 17   (raw bytes)
//   int8      = 20   (i64 BE)
//   int2      = 21   (i16 BE)
//   int4      = 23   (i32 BE)
//   text      = 25   (utf-8 bytes, len-prefixed in wire)
//   float4    = 700  (IEEE 754 single, BE)
//   float8    = 701  (IEEE 754 double, BE)
//   varchar   = 1043 (utf-8 bytes)
//   timestamp = 1114 (i64 microseconds since 2000-01-01 00:00:00 UTC)

+std.bytes.{ set set_be32 be32 size addr trim at }
+std.process.{ arena_alloc }
+std.postgres.frame.{ set_be16 be16 }

@rt(rt_copy_bytes)
@rt(rt_load_u8)
@rt(rt_load_u32)
@rt(rt_load_u64)

// ── OID constants ───────────────────────────────────────────────

pub const OID_BOOL      = 16
pub const OID_BYTEA     = 17
pub const OID_INT8      = 20
pub const OID_INT2      = 21
pub const OID_INT4      = 23
pub const OID_TEXT      = 25
pub const OID_FLOAT4    = 700
pub const OID_FLOAT8    = 701
pub const OID_VARCHAR   = 1043
pub const OID_TIMESTAMP = 1114

// ── 64-bit big-endian helpers (not in std.bytes) ────────────────

pub set_be64 is {
  b buf off i64 val i64 -> ret i64 {
    set(b off     val >> 56 & 0xff)
    set(b off + 1 val >> 48 & 0xff)
    set(b off + 2 val >> 40 & 0xff)
    set(b off + 3 val >> 32 & 0xff)
    set(b off + 4 val >> 24 & 0xff)
    set(b off + 5 val >> 16 & 0xff)
    set(b off + 6 val >> 8  & 0xff)
    set(b off + 7 val       & 0xff)
    ret 0
  }
}

pub be64 is {
  b buf off i64 -> ret i64 {
    let b0 = b[off]
    let b1 = b[off + 1]
    let b2 = b[off + 2]
    let b3 = b[off + 3]
    let b4 = b[off + 4]
    let b5 = b[off + 5]
    let b6 = b[off + 6]
    let b7 = b[off + 7]
    ret b0 << 56 | b1 << 48 | b2 << 40 | b3 << 32 | b4 << 24 | b5 << 16 | b6 << 8 | b7
  }
}

// ── encoders ─────────────────────────────────────────────────────
//
// Each encoder returns a fresh buf containing the binary wire bytes
// of one parameter — caller stitches them into a Bind frame with a
// 4-byte length prefix per column (see conn.lake / extended_query).

pub enc_int2 is {
  v i64 -> ret buf {
    let b = arena_alloc(2)
    set_be16(b 0 v)
    ret b
  }
}

pub enc_int4 is {
  v i64 -> ret buf {
    let b = arena_alloc(4)
    set_be32(b 0 v)
    ret b
  }
}

pub enc_int8 is {
  v i64 -> ret buf {
    let b = arena_alloc(8)
    set_be64(b 0 v)
    ret b
  }
}

pub enc_bool is {
  v i64 -> ret buf {
    let b = arena_alloc(1)
    when v == 0 {
      true  -> { set(b 0 0) }
      false -> { set(b 0 1) }
    }
    ret b
  }
}

// `text` / `varchar` / `bytea` — pass-through.  Postgres binary
// format for these IS the raw payload bytes (length comes from the
// frame's per-column length field).
pub enc_text is {
  s buf -> ret buf {
    let n = size(s)
    let b = arena_alloc(n)
    rt_copy_bytes(b 0 s 0 n)
    ret b
  }
}

// `timestamp` — microseconds since 2000-01-01 00:00:00 UTC.  Caller
// is responsible for time-zone conversion; we just wire-encode.
pub enc_timestamp is {
  micros_since_pg_epoch i64 -> ret buf {
    ret enc_int8(micros_since_pg_epoch)
  }
}

// `float4` / `float8` — bit-pattern reinterpret.  Lake doesn't yet
// expose IEEE 754 conversion intrinsics from i64, so we trust the
// caller to provide the IEEE 754 bit pattern already in an i64.
// TODO once #144 (numeric primitives) lands: take an f64/f32 and
// reinterpret via rt_bitcast_*.  Tracked in feature 154 known-gaps.
pub enc_float4 is {
  bits i64 -> ret buf { ret enc_int4(bits) }
}

pub enc_float8 is {
  bits i64 -> ret buf { ret enc_int8(bits) }
}

// ── decoders ─────────────────────────────────────────────────────
//
// Each decoder reads `len` bytes starting at `off` from `payload`
// and returns the decoded value as i64 (or a fresh buf for variable-
// length text/bytea).  Caller knows the field's OID + format code
// from the prior RowDescription.

pub dec_int2 is {
  payload buf off i64 -> ret i64 {
    let hi = payload[off]
    let lo = payload[off + 1]
    // sign extend
    when hi >= 128 {
      true -> { ret hi << 8 | lo | 0 - 65536 }
      _    -> { ret hi << 8 | lo }
    }
  }
}

pub dec_int4 is {
  payload buf off i64 -> ret i64 {
    let v = be32(payload off)
    when v >= 2147483648 {
      true -> { ret v - 4294967296 }
      _    -> { ret v }
    }
  }
}

pub dec_int8 is {
  payload buf off i64 -> ret i64 {
    ret be64(payload off)
  }
}

pub dec_bool is {
  payload buf off i64 -> ret i64 {
    ret payload[off]
  }
}

// Variable-length text/bytea decoder — copy `len` bytes into a fresh
// arena_alloc buf.  Caller frees implicitly at actor death.
pub dec_text is {
  payload buf off i64 len i64 -> ret buf {
    let out = arena_alloc(len)
    rt_copy_bytes(out 0 payload off len)
    ret out
  }
}

// ── format codes ─────────────────────────────────────────────────
//
// 0 = text, 1 = binary.  Helper for the conn layer when picking the
// per-OID format in Bind/Describe.
// MVP: always use binary format.  Wire layout for text/varchar/bytea
// is identical between text/binary modes (raw bytes either way), so
// "always binary" is safe and saves the server a text-formatting
// pass for the numeric types.
pub binary_format_for is {
  oid i64 -> ret i64 { ret 1 }
}
