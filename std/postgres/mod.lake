// Postgres MVP — public surface.
//
// See docs/state/features/154_postgres_client.md for design notes
// and known gaps.  This module owns the connect / query / prepare /
// execute entry points; framing + auth + binary codecs live in
// sibling modules.
//
// Quick example:
//
//   +std.postgres.{ connect query close }
//   main is {
//     _ -> {
//       let c = connect("127.0.0.1" 5432 "postgres" "postgres" "test")
//       when c.ok {
//         1 -> {
//           let rows = query(c "SELECT 1::int4")
//           // rows is a Rows record — iterate via row_count / row_at.
//           close(c)
//         }
//         _ -> { eprintln("pg: connect failed") }
//       }
//     }
//   }

+std.bytes.{ set set_be32 be32 size addr trim at }
+std.process.{ arena_alloc die }
+std.io.{ println eprintln }
+std.strings.{ slice_buf concat_bb int_to_buf }
+std.postgres.frame.{
  encode_msg send_msg read_msg
  pwrite_cstr pwrite_u8 pwrite_u16 pwrite_u32 pwrite_bytes pwrite_cbuf
  pread_cstr be16 set_be16
}
+std.postgres.conn.{
  Conn build_startup drive_auth pump_until_ready connect_on_fd close_conn
}
+std.postgres.types.{ binary_format_for }
+std.experimental.sys.{ SYS_SOCKET SYS_CONNECT }

@rt(rt_syscall)
@rt(rt_copy_bytes)
@rt(rt_send_async)
@rt(rt_recv_async)
@rt(len)

// ── public types ────────────────────────────────────────────────

// `Rows` — result of a query.  `buf_data` holds the raw concatenated
// DataRow payloads back-to-back; `row_offsets` holds the byte offset
// into `buf_data` at which row N begins (so row N's payload is
// `buf_data[row_offsets[N] .. row_offsets[N+1]]`).  `n_rows` is the
// row count, `n_cols` the per-row column count.
//
// Without first-class lists this is the most compact representation
// — caller iterates via `row_count(rows)` + `row_field(rows, r, c)`.
pub Rows is {
  buf_data buf
  row_offsets buf
  n_rows i64
  n_cols i64
  ok i64
  err_msg buf
}

// `Stmt` — a prepared statement handle.  Keeps the server-side name
// so `execute` can refer to it later, plus the parameter OIDs the
// server inferred (from ParameterDescription).
pub Stmt is {
  name buf
  n_params i64
  param_oids buf  // n_params × 4 bytes, BE u32 each
  n_cols i64
  col_oids buf    // n_cols × 4 bytes
  ok i64
}

// ── connect ──────────────────────────────────────────────────────
//
// Opens TCP via raw socket(2) + connect(2) syscalls (Lake's runtime
// currently exposes rt_listen_tcp for *servers* but no client dial;
// see docs/state/features/154_postgres_client.md for the tracking
// note).  Host MUST be a 4-octet IPv4 buf — i.e. ip_v4(127 0 0 1).
// Once rt_connect_tcp lands we'll replace this with one rt-call.
pub connect is {
  host buf port i64 user buf db buf password buf -> ret Conn {
    // socket(AF_INET=2, SOCK_STREAM=1, IPPROTO=0)
    let fd = rt_syscall(SYS_SOCKET 2 1 0 0 0 0)
    when fd < 0 {
      true -> { ret Conn(0 - 1 0 0 0) }
      _ -> {
        // sockaddr_in: { sin_family u16=2, sin_port u16 BE, sin_addr u32, _pad x8 }
        let sa = arena_alloc(16)
        set(sa 0 2)
        set(sa 1 0)
        // port in network byte order
        set(sa 2 port >> 8 & 0xff)
        set(sa 3 port      & 0xff)
        // ipv4 octets
        set(sa 4 host[0])
        set(sa 5 host[1])
        set(sa 6 host[2])
        set(sa 7 host[3])
        // zero the 8-byte pad
        set(sa 8 0)  set(sa 9 0)  set(sa 10 0) set(sa 11 0)
        set(sa 12 0) set(sa 13 0) set(sa 14 0) set(sa 15 0)
        let rc = rt_syscall(SYS_CONNECT fd addr(sa) 16 0 0 0)
        when rc < 0 {
          true -> { ret Conn(0 - 1 0 0 0) }
          _ -> { ret connect_on_fd(fd user db password) }
        }
      }
    }
  }
}

// `ip_v4(a, b, c, d)` — build a 4-byte buf from four octets.  Use
// when calling `connect` with a literal IP.
pub ip_v4 is {
  a i64 b i64 c i64 d i64 -> ret buf {
    let h = arena_alloc(4)
    set(h 0 a)
    set(h 1 b)
    set(h 2 c)
    set(h 3 d)
    ret h
  }
}

pub close is {
  c Conn -> ret i64 { ret close_conn(c) }
}

// ── simple query ('Q') ──────────────────────────────────────────
//
// Send "Q" + NUL-terminated SQL; consume the response stream until
// ReadyForQuery.  Response stream for a SELECT:
//   'T'  RowDescription (n_cols + per-col metadata)
//   'D'  DataRow × N      (n_cols + per-col length-prefixed bytes)
//   'C'  CommandComplete  ("SELECT 1\0")
//   'Z'  ReadyForQuery
// For DML the 'T' is replaced with nothing and you get CommandComplete
// directly.  Errors come back as 'E' ErrorResponse before 'Z'.

pub query is {
  c Conn sql str -> ret Rows {
    let sql_len = len(sql)
    let pl = arena_alloc(sql_len + 1)
    rt_copy_bytes(pl 0 sql 0 sql_len)
    set(pl sql_len 0)
    send_msg(c.fd 81 pl sql_len + 1)
    ret collect_rows(c.fd)
  }
}

// `collect_rows` — drive the response pump until ReadyForQuery.
// Accumulates DataRow payloads into a single buf (compacted) and a
// row_offsets table.
pub collect_rows is {
  fd i64 -> ret Rows {
    // Worst-case 64 KB row buffer; resize TODO post-MVP.
    let data_max = 65536
    let data = arena_alloc(data_max)
    let offsets = arena_alloc(1024 * 4)
    let empty_err = arena_alloc(0)
    ret pump_rows(fd data 0 offsets 0 0 0 empty_err)
  }
}

pub pump_rows is {
  fd i64
  data buf data_off i64
  offsets buf row_idx i64
  n_cols i64
  err_flag i64
  err_msg buf -> ret Rows {
    let r = read_msg(fd)
    let type = r.0
    let payload = r.1
    when type {
      // 'Z' ReadyForQuery → done
      90 -> {
        when err_flag {
          1 -> { ret Rows(data offsets row_idx n_cols 0 err_msg) }
          _ -> {
            // Write sentinel end-offset so callers can compute the
            // last row's length.
            set_be32(offsets row_idx * 4 data_off)
            ret Rows(data offsets row_idx n_cols 1 err_msg)
          }
        }
      }
      // 'T' RowDescription
      84 -> {
        let ncols = be16(payload 0)
        self(fd data data_off offsets row_idx ncols err_flag err_msg)
      }
      // 'D' DataRow
      68 -> {
        // Record start offset for THIS row.
        set_be32(offsets row_idx * 4 data_off)
        let plen = size(payload)
        rt_copy_bytes(data data_off payload 0 plen)
        self(fd data data_off + plen offsets row_idx + 1 n_cols err_flag err_msg)
      }
      // 'C' CommandComplete
      67 -> { self(fd data data_off offsets row_idx n_cols err_flag err_msg) }
      // 'E' ErrorResponse
      69 -> {
        self(fd data data_off offsets row_idx n_cols 1 payload)
      }
      // 'N' NoticeResponse — skip
      78 -> { self(fd data data_off offsets row_idx n_cols err_flag err_msg) }
      // 'I' EmptyQueryResponse — treat like CommandComplete
      73 -> { self(fd data data_off offsets row_idx n_cols err_flag err_msg) }
      // 'S' ParameterStatus mid-stream (e.g. SET) — skip
      83 -> { self(fd data data_off offsets row_idx n_cols err_flag err_msg) }
      _  -> { self(fd data data_off offsets row_idx n_cols err_flag err_msg) }
    }
  }
}

// Row access helpers.
//
// DataRow payload layout (per row):
//   n_cols:u16 BE
//   n_cols × { len:i32 BE   ; len bytes }      ; len == -1 means NULL.
//
// `row_field(rows, row_idx, col_idx)` returns the raw bytes of the
// requested field as a fresh buf, or an empty buf for NULL.  Caller
// is expected to dec_* the bytes per the known OID.
pub row_count is { rows Rows -> ret i64 { ret rows.n_rows } }

pub col_count is { rows Rows -> ret i64 { ret rows.n_cols } }

pub row_field is {
  rows Rows r i64 c i64 -> ret buf {
    let row_start = be32(rows.row_offsets r * 4)
    // Skip the leading u16 column count, then walk c columns.
    let off = scan_to_col(rows.buf_data row_start + 2 0 c)
    let len_raw = be32(rows.buf_data off)
    when len_raw == 4294967295 {
      true -> { ret arena_alloc(0) }
      _ -> {
        let out = arena_alloc(len_raw)
        rt_copy_bytes(out 0 rows.buf_data off + 4 len_raw)
        ret out
      }
    }
  }
}

pub scan_to_col is {
  data buf off i64 cur i64 target i64 -> ret i64 {
    when cur >= target {
      true -> { ret off }
      _ -> {
        let l = be32(data off)
        when l == 4294967295 {
          true -> { self(data off + 4 cur + 1 target) }
          _    -> { self(data off + 4 + l cur + 1 target) }
        }
      }
    }
  }
}

// ── extended query: prepare ─────────────────────────────────────
//
// Send:
//   'P' Parse: name "\0" sql "\0" n_oid:u16 (zero — let server infer)
//   'D' Describe: 'S' name "\0"
//   'S' Sync
// Read:
//   '1' ParseComplete
//   't' ParameterDescription: n_params:u16 + n_params × oid:u32
//   'T' RowDescription: n_cols:u16 + per-col metadata (we just keep
//                       the OID at offset 6 of each entry)
//   'Z' ReadyForQuery
pub prepare is {
  c Conn name str sql str -> ret Stmt {
    let name_len = len(name)
    let sql_len = len(sql)
    let pl_size = name_len + 1 + sql_len + 1 + 2
    let pl = arena_alloc(pl_size)
    let o1 = pwrite_cstr(pl 0 name)
    let o2 = pwrite_cstr(pl o1 sql)
    let o3 = pwrite_u16(pl o2 0)
    send_msg(c.fd 80 pl o3)
    // Describe: 'S' (statement) + name
    let dpl = arena_alloc(1 + name_len + 1)
    let d1 = pwrite_u8(dpl 0 83) // 'S'
    let d2 = pwrite_cstr(dpl d1 name)
    send_msg(c.fd 68 dpl d2)
    // Sync
    let empty = arena_alloc(0)
    send_msg(c.fd 83 empty 0)
    // Pump for ParseComplete / ParameterDescription / RowDescription / Ready.
    let name_buf = arena_alloc(name_len)
    rt_copy_bytes(name_buf 0 name 0 name_len)
    let empty_oids = arena_alloc(0)
    ret pump_describe(c.fd name_buf 0 empty_oids 0 empty_oids 0)
  }
}

pub pump_describe is {
  fd i64
  name buf
  n_params i64 param_oids buf
  n_cols i64 col_oids buf
  done i64 -> ret Stmt {
    when done {
      1 -> { ret Stmt(name n_params param_oids n_cols col_oids 1) }
      _ -> {
        let r = read_msg(fd)
        let type = r.0
        let payload = r.1
        when type {
          // 'Z' done
          90 -> { ret Stmt(name n_params param_oids n_cols col_oids 1) }
          // '1' ParseComplete
          49 -> { self(fd name n_params param_oids n_cols col_oids 0) }
          // 't' ParameterDescription
          116 -> {
            let np = be16(payload 0)
            let oids = arena_alloc(np * 4)
            rt_copy_bytes(oids 0 payload 2 np * 4)
            self(fd name np oids n_cols col_oids 0)
          }
          // 'T' RowDescription — for each column: name\0 table_oid:u32
          //   col_num:u16 type_oid:u32 type_len:u16 type_mod:u32 fmt:u16
          84 -> {
            let nc = be16(payload 0)
            let oids = arena_alloc(nc * 4)
            extract_row_desc_oids(payload 2 oids 0 nc)
            self(fd name n_params param_oids nc oids 0)
          }
          // 'n' NoData (statement returns no rows)
          110 -> { self(fd name n_params param_oids 0 col_oids 0) }
          // 'E' ErrorResponse
          69 -> { ret Stmt(name 0 param_oids 0 col_oids 0) }
          _  -> { self(fd name n_params param_oids n_cols col_oids 0) }
        }
      }
    }
  }
}

// Per RowDescription entry, advance past name\0, skip 4+2 bytes, read
// 4-byte OID, skip 2+4+2.
pub extract_row_desc_oids is {
  payload buf off i64 oids buf idx i64 nc i64 -> ret i64 {
    when idx >= nc {
      true -> { ret 0 }
      _ -> {
        let pl_size = size(payload)
        let name_end = scan_nul_at(payload off pl_size)
        // After name+NUL: table_oid(4) col_num(2) type_oid(4) ...
        let oid_off = name_end + 1 + 4 + 2
        let oid = be32(payload oid_off)
        set_be32(oids idx * 4 oid)
        // Skip type_oid(4) type_len(2) type_mod(4) fmt(2) = 12 after name+NUL+4+2
        let next = name_end + 1 + 4 + 2 + 4 + 2 + 4 + 2
        self(payload next oids idx + 1 nc)
      }
    }
  }
}

pub scan_nul_at is {
  b buf i i64 n i64 -> ret i64 {
    when i >= n {
      true -> { ret n }
      _ -> {
        when b[i] == 0 {
          true -> { ret i }
          _    -> { self(b i + 1 n) }
        }
      }
    }
  }
}

// ── extended query: execute ─────────────────────────────────────
//
// Args are passed as a single buf laid out as:
//   n_args:u16 BE
//   n_args × { len:i32 BE ; payload bytes }
// The caller built this from type-specific enc_* functions.  This
// keeps `execute` arity-free without depending on first-class lists.
pub execute is {
  c Conn stmt Stmt args buf -> ret Rows {
    let stmt_name_len = size(stmt.name)
    let args_total = size(args)
    // Bind frame layout:
    //   portal_name\0 (empty) stmt_name\0
    //   n_param_formats:u16 (= n_params) + n_params × format_code:u16 (all 1)
    //   n_params:u16 + n_params × { len:i32 BE ; bytes }
    //   n_result_formats:u16 (= n_cols) + n_cols × format_code:u16 (all 1)
    let np = stmt.n_params
    let nc = stmt.n_cols
    let bind_size = 1 + stmt_name_len + 1 + 2 + np * 2 + args_total + 2 + nc * 2
    let bind = arena_alloc(bind_size)
    let o1 = pwrite_u8(bind 0 0)         // empty portal name
    let o2 = pwrite_cbuf(bind o1 stmt.name)
    let o3 = pwrite_u16(bind o2 np)
    let o4 = write_format_codes(bind o3 0 np)
    let o5 = pwrite_bytes(bind o4 args args_total)
    let o6 = pwrite_u16(bind o5 nc)
    let o7 = write_format_codes(bind o6 0 nc)
    send_msg(c.fd 66 bind o7)
    // Execute portal "" with row_max = 0 (no limit).
    let epl = arena_alloc(1 + 4)
    let e1 = pwrite_u8(epl 0 0)
    let e2 = pwrite_u32(epl e1 0)
    send_msg(c.fd 69 epl e2)
    // Sync
    let empty = arena_alloc(0)
    send_msg(c.fd 83 empty 0)
    ret collect_rows(c.fd)
  }
}

pub write_format_codes is {
  bind buf off i64 i i64 n i64 -> ret i64 {
    when i >= n {
      true -> { ret off }
      _ -> {
        set_be16(bind off 1)
        self(bind off + 2 i + 1 n)
      }
    }
  }
}

// ── args builder ────────────────────────────────────────────────
//
// `build_args(n_args, ...)` isn't expressible without varargs.
// Caller assembles a fresh buf the shape of which is documented
// above, OR uses the helpers below for the common single/two-arg
// cases.

// One-arg payload: n_args=1, [len:i32][bytes].
pub args1 is {
  a0 buf -> ret buf {
    let l0 = size(a0)
    let total = 2 + 4 + l0
    let out = arena_alloc(total)
    let o1 = pwrite_u16(out 0 1)
    let o2 = pwrite_u32(out o1 l0)
    pwrite_bytes(out o2 a0 l0)
    ret out
  }
}

// Two-arg payload.
pub args2 is {
  a0 buf a1 buf -> ret buf {
    let l0 = size(a0)
    let l1 = size(a1)
    let total = 2 + 4 + l0 + 4 + l1
    let out = arena_alloc(total)
    let o1 = pwrite_u16(out 0 2)
    let o2 = pwrite_u32(out o1 l0)
    let o3 = pwrite_bytes(out o2 a0 l0)
    let o4 = pwrite_u32(out o3 l1)
    pwrite_bytes(out o4 a1 l1)
    ret out
  }
}

// Three-arg payload (rare; cap at 3 for MVP).
pub args3 is {
  a0 buf a1 buf a2 buf -> ret buf {
    let l0 = size(a0)
    let l1 = size(a1)
    let l2 = size(a2)
    let total = 2 + (4 + l0) + (4 + l1) + (4 + l2)
    let out = arena_alloc(total)
    let o1 = pwrite_u16(out 0 3)
    let o2 = pwrite_u32(out o1 l0)
    let o3 = pwrite_bytes(out o2 a0 l0)
    let o4 = pwrite_u32(out o3 l1)
    let o5 = pwrite_bytes(out o4 a1 l1)
    let o6 = pwrite_u32(out o5 l2)
    pwrite_bytes(out o6 a2 l2)
    ret out
  }
}

// ── error response parsing ──────────────────────────────────────
//
// ErrorResponse payload is a sequence of field-tag/value pairs,
// each NUL-terminated, ending with a zero byte:
//
//   [tag:u8][value\0]...[\0]
//
// Common tags: 'S' (Severity), 'C' (SQLSTATE), 'M' (Message),
// 'D' (Detail), 'H' (Hint), 'P' (Position).  We extract just the
// 'M' field for MVP.
pub error_message is {
  payload buf -> ret buf {
    let n = size(payload)
    ret scan_error_field(payload 0 n)
  }
}

pub scan_error_field is {
  payload buf off i64 n i64 -> ret buf {
    when off >= n {
      true -> { ret arena_alloc(0) }
      _ -> {
        let tag = payload[off]
        when tag {
          0 -> { ret arena_alloc(0) }
          77 -> {
            // 'M' — return until NUL.
            let end = scan_nul_at(payload off + 1 n)
            ret slice_buf(payload off + 1 end - off - 1)
          }
          _ -> {
            // skip this field — find its NUL terminator, recurse.
            let end = scan_nul_at(payload off + 1 n)
            self(payload end + 1 n)
          }
        }
      }
    }
  }
}
