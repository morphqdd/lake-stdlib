// HMAC-SHA256 — RFC 2104.  Builds on `std.crypto.sha256`.
// HMAC(K, m) = SHA-256( (K' XOR opad) || SHA-256( (K' XOR ipad) || m ) )
// K' = K padded to 64 bytes (or its hash if longer); ipad=0x36, opad=0x5C.

+std.bytes.{ at set }
+std.crypto.sha256.{ sha256 sha256_into }
+std.process.{ alloc_or_die }
@rt(rt_copy_bytes)

// hmac_sha256(key key_len msg msg_len) → 32-byte digest buffer.
pub hmac_sha256 is {
  key buf key_len i64 msg buf msg_len i64 -> ret buf {
    let nk_pair = normalize_key(key key_len)
    let k_norm = nk_pair.1
    let k_len = nk_pair.0
    let inner_in = build_padded_block(k_norm k_len 54)  // 54 = 0x36
    let outer_in = build_padded_block(k_norm k_len 92)  // 92 = 0x5C
    // inner = sha256( (k XOR ipad) || msg )
    let inner_buf = concat_buf(inner_in 64 msg msg_len)
    let total_inner = 64 + msg_len
    let inner_hash = sha256(inner_buf total_inner)
    // outer = sha256( (k XOR opad) || inner )
    let outer_buf = concat_buf(outer_in 64 inner_hash 32)
    let out = sha256(outer_buf 96)
    ret out
  }
}

// ── zero-alloc HMAC (#156) ───────────────────────────────────
// Allocates nothing — all scratch caller-supplied and reused, with
// the two pre-XOR'd key blocks (ipad_block/opad_block) built once by
// the caller since PBKDF2 keeps the key fixed across the loop.
// Digest written into `out` (32 B).
pub hmac_sha256_into is {
  out buf
  ipad_block buf opad_block buf
  msg buf msg_len i64
  inner_in buf inner_h buf outer_in buf
  k_tbl buf w buf st buf pad buf -> ret i64 {
    // inner = sha256( ipad_block || msg )
    rt_copy_bytes(inner_in 0 ipad_block 0 64)
    rt_copy_bytes(inner_in 64 msg 0 msg_len)
    sha256_into(inner_h inner_in 64 + msg_len k_tbl w st pad)
    // outer = sha256( opad_block || inner )
    rt_copy_bytes(outer_in 0 opad_block 0 64)
    rt_copy_bytes(outer_in 64 inner_h 0 32)
    sha256_into(out outer_in 96 k_tbl w st pad)
    ret 0
  }
}

// Returns `{ effective_len, buf }`.  When `key_len > 64` the key is
// replaced by its 32-byte SHA-256 hash; otherwise passed through.
normalize_key is {
  key buf key_len i64 -> ret {i64 buf} {
    when key_len > 64 {
      true  -> {
        let h = sha256(key key_len)
        ret { 32 h }
      }
      false -> { ret { key_len key } }
    }
  }
}

// 64-byte block: key in the first `key_len` bytes (tail already 0x00
// from mmap'd pages), every byte XOR'd with `pad` (0x36 / 0x5C).
pub build_padded_block is {
  key buf key_len i64 pad i64 -> ret buf {
    let block = alloc_or_die(64)
    rt_copy_bytes(block 0 key 0 key_len)
    xor_loop(block 0 64 pad)
    ret block
  }
}

// Loop: dst[i] = dst[i] XOR pad, for i in [start..end).
xor_loop is {
  dst buf i i64 end i64 pad i64 -> ret i64 {
    when i >= end {
      true -> { ret 0 }
      false -> {
        let cur = at(dst i)
        let new = cur ^ pad
        set(dst i new)
        self(dst i + 1 end pad)
      }
    }
  }
}

// Concatenate two buffers into a fresh `len_a + len_b` block.
concat_buf is {
  a buf len_a i64 b buf len_b i64 -> ret buf {
    let out = alloc_or_die(len_a + len_b)
    rt_copy_bytes(out 0 a 0 len_a)
    rt_copy_bytes(out len_a b 0 len_b)
    ret out
  }
}
