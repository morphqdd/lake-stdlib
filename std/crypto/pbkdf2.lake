// PBKDF2-HMAC-SHA256 — RFC 8018 §5.2.
//
// DK = T_1 || T_2 || ... || T_l   (truncated to dk_len bytes)
//   where T_i = U_1 XOR U_2 XOR ... XOR U_c
//         U_1 = HMAC(password, salt || INT_BE32(i))
//         U_j = HMAC(password, U_{j-1})   for j > 1
//
// hash-len = 32 (SHA-256 output size).
// Each `T_i` block is 32 bytes; the total `l` = ceil(dk_len / 32).
//
// Verified against `hashlib.pbkdf2_hmac("sha256", …)` —
// see `benchmark/test/pbkdf2_kat.lake` (TODO).

+std.bytes.{ at set set_be32 }
+std.crypto.hmac.{ hmac_sha256 }
+std.process.{ alloc_or_die }
@rt(rt_copy_bytes)

// pbkdf2_sha256(password, pwd_len, salt, salt_len, iters, dk_len)
// → buffer of `dk_len` bytes.
pub pbkdf2_sha256 is {
  password buf pwd_len i64 salt buf salt_len i64 iters i64 dk_len i64 -> ret buf {
    let dk = alloc_or_die(dk_len)
    let blocks = (dk_len + 31) / 32
    derive_blocks(password pwd_len salt salt_len iters dk 0 blocks dk_len)
    ret dk
  }
}

// Outer loop: produce `blocks` 32-byte T_i values, write each to
// `dk[(i-1)*32..]`, then truncate the final block to fit `dk_len`.
derive_blocks is {
  password buf pwd_len i64
  salt buf salt_len i64
  iters i64
  dk buf
  i i64
  blocks i64
  dk_len i64 -> ret i64 {
    when i >= blocks {
      true -> { ret 0 }
      false -> {
        let block_idx = i + 1
        let t = derive_block(password pwd_len salt salt_len iters block_idx)
        let off = i * 32
        let take = remaining_take(dk_len off)
        rt_copy_bytes(dk off t 0 take)
        self(password pwd_len salt salt_len iters dk i + 1 blocks dk_len)
      }
    }
  }
}

// How many bytes of the current 32-byte T_i block belong in the
// final DK — the last block may be partial (`dk_len % 32` != 0).
remaining_take is {
  dk_len i64 off i64 -> ret i64 {
    let left = dk_len - off
    when left >= 32 {
      true  -> { ret 32 }
      false -> { ret left }
    }
  }
}

// One T_i block: U_1 = HMAC(pw, salt || INT_BE32(i));
//                U_j = HMAC(pw, U_{j-1})  for j > 1;
//                T_i = U_1 XOR U_2 XOR ... XOR U_iters.
derive_block is {
  password buf pwd_len i64
  salt buf salt_len i64
  iters i64
  block_idx i64 -> ret buf {
    // Build salt || INT_BE32(block_idx) — first HMAC input.
    let u_in = alloc_or_die(salt_len + 4)
    rt_copy_bytes(u_in 0 salt 0 salt_len)
    set_be32(u_in salt_len block_idx)
    let u1 = hmac_sha256(password pwd_len u_in salt_len + 4)
    // Accumulator (T) starts as a copy of U_1; subsequent U's get
    // XOR'd in by `iterate_u`.
    let t = alloc_or_die(32)
    rt_copy_bytes(t 0 u1 0 32)
    iterate_u(password pwd_len u1 t 1 iters)
    ret t
  }
}

// Iterations U_2..U_iters: each U_j = HMAC(pw, U_{j-1}); XOR into t.
iterate_u is {
  password buf pwd_len i64
  u_prev buf
  t buf
  j i64
  iters i64 -> ret i64 {
    when j >= iters {
      true -> { ret 0 }
      false -> {
        let u_next = hmac_sha256(password pwd_len u_prev 32)
        xor_into(t u_next 0 32)
        self(password pwd_len u_next t j + 1 iters)
      }
    }
  }
}

// t[i..end] ^= src[i..end]
xor_into is {
  t buf src buf i i64 end i64 -> ret i64 {
    when i >= end {
      true -> { ret 0 }
      false -> {
        let a = at(t i)
        let b = at(src i)
        let r = a ^ b
        set(t i r)
        self(t src i + 1 end)
      }
    }
  }
}
