// PBKDF2-HMAC-SHA256 — RFC 8018 §5.2.
// DK = T_1 || ... || T_l (truncated to dk_len), T_i = U_1 ^ ... ^ U_c,
// U_1 = HMAC(pwd, salt || INT_BE32(i)), U_j = HMAC(pwd, U_{j-1}).
//
// Zero-alloc hot loop (#156): all scratch is pre-allocated once and
// reused via `hmac_sha256_into`, so the 4096-iter derivation never
// exhausts the actor arena.

+std.bytes.{ at set set_be32 }
+std.crypto.hmac.{ build_padded_block hmac_sha256_into }
+std.crypto.sha256.{ sha256 padded_cap fill_k_table }
+std.process.{ alloc_or_die }
@rt(rt_copy_bytes)

// pbkdf2_sha256(password, pwd_len, salt, salt_len, iters, dk_len)
// → buffer of `dk_len` bytes.
pub pbkdf2_sha256 is {
  password buf pwd_len i64 salt buf salt_len i64 iters i64 dk_len i64 -> ret buf {
    // Normalise key to <= 64 bytes (HMAC block size).  One-time hash
    // for long keys; SCRAM/login passwords are short so this is the
    // identity branch in practice.
    let nk = norm_key(password pwd_len)
    let key = nk.1
    let key_len = nk.0

    // Constant padded key blocks — built once, reused every HMAC.
    let ipad_block = build_padded_block(key key_len 54)  // 0x36
    let opad_block = build_padded_block(key key_len 92)  // 0x5C

    // Largest HMAC message: U_1's input is salt||int32 (salt_len+4);
    // later U_j inputs are 32 bytes.  Size scratch to the max.
    let max_msg = max_i(salt_len + 4 32)
    let k_tbl = alloc_or_die(256)
    let _kf = fill_k_table(k_tbl)
    let w = alloc_or_die(256)
    let st = alloc_or_die(32)
    let inner_in = alloc_or_die(64 + max_msg)
    let inner_h = alloc_or_die(32)
    let outer_in = alloc_or_die(96)
    let pad = alloc_or_die(padded_cap(64 + max_msg))
    // Per-block scratch.
    let salt_int = alloc_or_die(salt_len + 4)
    let u_a = alloc_or_die(32)
    let u_b = alloc_or_die(32)
    let t = alloc_or_die(32)

    let dk = alloc_or_die(dk_len)
    let blocks = (dk_len + 31) / 32
    derive_blocks(salt salt_len iters dk 0 blocks dk_len
                  ipad_block opad_block salt_int u_a u_b t
                  inner_in inner_h outer_in k_tbl w st pad)
    ret dk
  }
}

// Key normalisation: keys longer than the 64-byte block size are
// replaced by their SHA-256 hash (one alloc, outside the loop).
norm_key is {
  password buf pwd_len i64 -> ret {i64 buf} {
    when pwd_len > 64 {
      true -> {
        let h = sha256(password pwd_len)
        ret { 32 h }
      }
      false -> { ret { pwd_len password } }
    }
  }
}

max_i is { a i64 b i64 -> ret i64 { when a >= b { true -> { ret a } _ -> { ret b } } } }

// Outer loop: produce `blocks` 32-byte T_i values, write each into
// dk[(i)*32..], truncating the final block to fit dk_len.
derive_blocks is {
  salt buf salt_len i64 iters i64 dk buf i i64 blocks i64 dk_len i64
  ipad_block buf opad_block buf salt_int buf u_a buf u_b buf t buf
  inner_in buf inner_h buf outer_in buf k_tbl buf w buf st buf pad buf -> ret i64 {
    when i >= blocks {
      true -> { ret 0 }
      false -> {
        let block_idx = i + 1
        // U_1 = HMAC(key, salt || INT_BE32(block_idx))
        rt_copy_bytes(salt_int 0 salt 0 salt_len)
        set_be32(salt_int salt_len block_idx)
        hmac_sha256_into(u_a ipad_block opad_block salt_int salt_len + 4
                         inner_in inner_h outer_in k_tbl w st pad)
        rt_copy_bytes(t 0 u_a 0 32)
        // T_i = U_1 ^ U_2 ^ ... ^ U_iters
        iterate_u(t u_a u_b 1 iters
                  ipad_block opad_block inner_in inner_h outer_in k_tbl w st pad)
        let off = i * 32
        let take = remaining_take(dk_len off)
        rt_copy_bytes(dk off t 0 take)
        self(salt salt_len iters dk i + 1 blocks dk_len
             ipad_block opad_block salt_int u_a u_b t
             inner_in inner_h outer_in k_tbl w st pad)
      }
    }
  }
}

// How many bytes of the current 32-byte T_i block belong in DK.
remaining_take is {
  dk_len i64 off i64 -> ret i64 {
    let left = dk_len - off
    when left >= 32 {
      true  -> { ret 32 }
      false -> { ret left }
    }
  }
}

// Iterations U_2..U_iters.  `u_prev`/`u_tmp` ping-pong: each step
// computes U_j into u_tmp from u_prev, XORs it into t, then swaps
// the two buffer roles for the next iteration.  No allocation.
iterate_u is {
  t buf u_prev buf u_tmp buf j i64 iters i64
  ipad_block buf opad_block buf inner_in buf inner_h buf outer_in buf
  k_tbl buf w buf st buf pad buf -> ret i64 {
    when j >= iters {
      true -> { ret 0 }
      false -> {
        hmac_sha256_into(u_tmp ipad_block opad_block u_prev 32
                         inner_in inner_h outer_in k_tbl w st pad)
        xor_into(t u_tmp 0 32)
        // Swap u_prev <-> u_tmp for the next round.
        self(t u_tmp u_prev j + 1 iters
             ipad_block opad_block inner_in inner_h outer_in k_tbl w st pad)
      }
    }
  }
}

// t[i..end] ^= src[i..end]
xor_into is {
  t buf src buf i i64 end i64 -> ret i64 {
    when i >= end {
      true -> { ret 0 }
      false -> {
        let a = at(t i)
        let b = at(src i)
        set(t i a ^ b)
        self(t src i + 1 end)
      }
    }
  }
}
