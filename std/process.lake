// Process-control helpers — thin wrappers over the actor-state rt-fns.
// `die` is inlined at the call site (#78 pure whitelist) so it marks
// the *caller's* actor for unlink, not a spawned child.

@rt(rt_allocate)
@rt(rt_arena_alloc)
@rt(rt_die_actor)
// Global process exit lives in `std.sys.exit` (re-export here would
// collide — bug #97).

// Mark the current actor for death; the scheduler unlinks it at the
// next quantum tick.  Queued side effects are retained.
pub die is {
  _ -> ret {} {
    rt_die_actor()
  }
}

// `alloc(n)` — re-export of `rt_allocate`.  Returns `{atom buf}`:
// `.0` is `:ok`/`:err`, `.1` carries the buf (or `:nomem` on error).
// Caller pattern-matches `r.0` and recovers or `die()`s.  Inlined (#78).
pub alloc is {
  n i64 -> ret {atom buf} {
    ret rt_allocate(n)
  }
}

// `alloc_or_die(n)` — arena-backed alloc that `die()`s on OOM.  Routes
// through the actor arena (#76) so the buf is reclaimed at actor death
// rather than leaking a slab chunk per call.
pub alloc_or_die is {
  n i64 -> ret buf {
    ret rt_arena_alloc(n)
  }
}

// `arena_alloc(n)` — bump-allocate from the per-actor arena (#138);
// reclaimed at actor death, no manual `rt_free`.  Falls back to a raw
// alloc (dying on OOM) when the 64 KB arena is exhausted or absent.
pub arena_alloc is {
  n i64 -> ret buf {
    ret rt_arena_alloc(n)
  }
}

