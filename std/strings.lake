// String building helpers.  Each `concat*` allocates a fresh
// fat-ptr buffer and copies the source bytes via `rt_copy_bytes`,
// the bounds-checked memcpy primitive shipped with the compiler.
// Returned value is a fat-ptr (i64 at the ABI level) pointing at the
// concatenated payload — same shape as a `str` literal, so it can
// be passed straight to `rt_write`, `rt_send_async`, `len`, etc.
//
// All wrappers are `ret`-typed so they compose with `let` and `pin`.
//
// `rt_allocate` returns `{atom buf}` under the tuple ABI (#87) —
// callers pattern-match on `r.0` and dispatch.  On `:err` we call
// `+std.process.die` (a Phase 2a-inlined wrapper over `rt_die_actor`)
// so the scheduler removes the dying actor cleanly at the next
// quantum boundary.  The synthesised `ret r.1` after `die()` is
// dead code path-wise but required for the ret-machine return-type
// check.
//
// For a slower but rt_copy_bytes-free implementation see
// `std/experimental/strings.lake`.

+std.process.{ die }

@rt(rt_allocate)
@rt(rt_copy_bytes)
@rt(len)

// Concatenate two strings.  Result length = len(a) + len(b).
pub concat is {
  a str b str -> ret buf {
    let la = len(a)
    let lb = len(b)
    let total = la + lb
    let r = rt_allocate(total)
    when r.0 {
      :ok -> {
        let dst = r.1
        rt_copy_bytes(dst 0 a 0 la)
        rt_copy_bytes(dst la b 0 lb)
        ret dst
      }
      _ -> {
        die()
        ret r.1
      }
    }
  }
}

// Three-way concat — common for `header + ": " + value` shapes.
pub concat3 is {
  a str b str c str -> ret buf {
    let la = len(a)
    let lb = len(b)
    let lc = len(c)
    let total = la + lb + lc
    let r = rt_allocate(total)
    when r.0 {
      :ok -> {
        let dst = r.1
        rt_copy_bytes(dst 0       a 0 la)
        rt_copy_bytes(dst la      b 0 lb)
        rt_copy_bytes(dst la + lb c 0 lc)
        ret dst
      }
      _ -> {
        die()
        ret r.1
      }
    }
  }
}

// Slice of `s` starting at `off` of length `n`.  Returns a fresh
// allocation; the source bytes are copied so the slice survives any
// later free of `s`.
pub slice is {
  s str off i64 n i64 -> ret buf {
    let r = rt_allocate(n)
    when r.0 {
      :ok -> {
        let dst = r.1
        rt_copy_bytes(dst 0 s off n)
        ret dst
      }
      _ -> {
        die()
        ret r.1
      }
    }
  }
}
