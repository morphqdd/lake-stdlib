// lash smoke fixture — exercises the full Phase 1 surface:
// schema construction + parse(argv) + getters.
//
// Build / run:
//   LAKE_PATH=$(pwd) lakec examples/lash_smoke/main.lake
//   ./examples/lash_smoke/build/main --verbose --name=foo bar  -> "ok"
//   ./examples/lash_smoke/build/main                            -> "ok"  (no required args)
//   ./examples/lash_smoke/build/main --bogus                    -> err msg + exit 2

+std.experimental.lash.{ parser flag opt positional parse get_flag get_opt get_positional }
+std.io.{ println eprintln_buf }
@rt(rt_exit)

main is {
  _ -> {
    let p = parser(0)
    let p = flag(p "verbose" "v")
    let p = opt(p "name" "n")
    let p = positional(p "input")
    let r = parse(p)
    when r.0 {
      :ok -> {
        pin println("ok")
        rt_exit(0)
      }
      :err -> {
        pin eprintln_buf(r.1)
        rt_exit(2)
      }
    }
  }
}
