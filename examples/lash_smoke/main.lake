// lash smoke fixture — covers the three argv shapes from the
// Phase 1 spec.  Build with
//
//   LAKE_PATH=$(pwd) lakec examples/lash_smoke/main.lake
//
// Run:
//   ./examples/lash_smoke/build/main --verbose --name=foo bar  -> "ok"
//   ./examples/lash_smoke/build/main -v -n foo bar             -> "ok"
//   ./examples/lash_smoke/build/main --bogus                   -> err + exit 2

+std.experimental.lash.{ parser flag opt positional parse get_flag get_opt get_positional }
+std.io.{ println print_buf eprintln_buf }
@rt(rt_exit)

main is {
  _ -> {
    let p = parser()
    let p = flag(p "verbose" "v")
    let p = opt(p "name" "n")
    let p = positional(p "input")
    let r = parse(p)
    when r.0 {
      :ok -> {
        let verbose = get_flag(p "verbose")
        let name_r = get_opt(p "name")
        let input_r = get_positional(p 0)
        pin println("ok")
        pin rt_exit(0)
      }
      :err -> {
        pin eprintln_buf(r.1)
        pin rt_exit(2)
      }
    }
  }
}
